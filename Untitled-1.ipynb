import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
from datetime import datetime
import pytz

# ------------------ Load Data ------------------
df = pd.read_csv("apps.csv")

# ------------------ Cleaning ------------------
df['Size'] = df['Size'].str.replace('M','', regex=False)
df['Size'] = pd.to_numeric(df['Size'], errors='coerce')

df['Installs'] = df['Installs'].str.replace('[+,]','', regex=True)
df['Installs'] = pd.to_numeric(df['Installs'], errors='coerce')

df['Last Updated'] = pd.to_datetime(df['Last Updated'], errors='coerce')

# ------------------ Filters ------------------
filtered_df = df[
    (df['Rating'] >= 4.0) &
    (df['Size'] >= 10) &
    (df['Last Updated'].dt.month == 1)
]

top_categories = (
    filtered_df
    .groupby('Category')
    .agg({
        'Rating':'mean',
        'Reviews':'sum',
        'Installs':'sum'
    })
    .sort_values('Installs', ascending=False)
    .head(10)
    .reset_index()
)

# ------------------ IST Time Check ------------------
ist = pytz.timezone("Asia/Kolkata")
current_time = datetime.now(ist).time()

start = datetime.strptime("15:00", "%H:%M").time()
end   = datetime.strptime("17:00", "%H:%M").time()

print("Top App Categories Dashboard")

# ------------------ Display Logic ------------------
if start <= current_time <= end:
    
    print("Chart is live (3 PM - 5 PM IST)")

    x = np.arange(len(top_categories))
    width = 0.35

    fig, ax = plt.subplots(figsize=(10,5))
    
    ax.bar(x - width/2, top_categories['Rating'], width, label='Avg Rating')
    ax.bar(x + width/2, top_categories['Reviews'], width, label='Total Reviews')

    ax.set_xticks(x)
    ax.set_xticklabels(top_categories['Category'], rotation=45)
    ax.set_title("Top 10 App Categories: Rating vs Reviews")
    ax.set_ylabel("Value")
    ax.legend()

    plt.tight_layout()
    plt.show()

else:
    print("This chart is available only between 3 PM and 5 PM IST.")
