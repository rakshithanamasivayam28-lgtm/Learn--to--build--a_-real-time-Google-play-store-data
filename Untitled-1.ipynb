import pandas as pd
import matplotlib.pyplot as plt
from datetime import datetime
import pytz

# ---------------- Load Data ----------------
df = pd.read_csv("apps.csv")

# ---------------- Cleaning ----------------
df['Size'] = df['Size'].str.replace('M','', regex=False)
df['Size'] = pd.to_numeric(df['Size'], errors='coerce')

df['Installs'] = df['Installs'].astype(str)
df['Installs'] = df['Installs'].str.replace('[+,]', '', regex=True)
df['Installs'] = pd.to_numeric(df['Installs'], errors='coerce')

df['Reviews'] = pd.to_numeric(df['Reviews'], errors='coerce')
df['Last Updated'] = pd.to_datetime(df['Last Updated'], errors='coerce')

# ---------------- Apply Filters ----------------
filtered_df = df[
    (df['Rating'] >= 4.0) &
    (df['Size'] >= 10) &
    (df['Last Updated'].dt.month == 1)
]

# ---------------- Top 10 Categories ----------------
top_categories = (
    filtered_df.groupby('Category')
    .agg({
        'Installs':'sum',
        'Rating':'mean',
        'Reviews':'sum'
    })
    .sort_values('Installs', ascending=False)
    .head(10)
    .reset_index()
)

# ---------------- IST Time Restriction ----------------
ist = pytz.timezone("Asia/Kolkata")
now = datetime.now(ist)
current_time = now.time()

start = datetime.strptime("19:00", "%H:%M").time()  # 7 PM
end   = datetime.strptime("21:00", "%H:%M").time()  # 9 PM

# ---------------- Plot Creation ----------------
image_path = "chart.png"

if start <= current_time <= end and not top_categories.empty:
    x = range(len(top_categories))
    width = 0.35

    fig, ax = plt.subplots(figsize=(12,6), facecolor="#000000")

    # Bars
    bars_rating = ax.bar([i - width/2 for i in x],
                         top_categories['Rating'],
                         width,
                         label="Average Rating",
                         color="#00bfff")

    bars_reviews = ax.bar([i + width/2 for i in x],
                          top_categories['Reviews'],
                          width,
                          label="Total Reviews",
                          color="#ff9933")

    # Labels on top of bars
    for bar in bars_rating:
        height = bar.get_height()
        ax.text(bar.get_x() + bar.get_width()/2,
                height + 0.05,
                f"{height:.2f}",
                ha='center', color='white', fontsize=10)
    for bar in bars_reviews:
        height = bar.get_height()
        ax.text(bar.get_x() + bar.get_width()/2,
                height + 0.02*height,
                f"{int(height)}",
                ha='center', color='white', fontsize=10)

    # Axis and title
    ax.set_xticks(x)
    ax.set_xticklabels(top_categories['Category'], rotation=45, color='white', fontsize=12)
    ax.set_ylabel("Values", color='white', fontsize=14)
    ax.set_title("Top 10 App Categories: Rating vs Reviews", color='white', fontsize=16)

    # Single legend box
    legend = ax.legend(loc='upper right', facecolor='#222222', edgecolor='white', fontsize=12)
    for text in legend.get_texts():
        text.set_color('white')

    # Y-axis ticks
    ax.tick_params(axis='y', colors='white')

    plt.tight_layout()
    plt.savefig(image_path, facecolor="#000000")
    plt.close()

    chart_html = f'<img src="{image_path}" width="100%">'

else:
    chart_html = "<h2 style='color:#ff4c4c;'>Graph Available Only Between 7 PM and 9 PM IST</h2>"

# ---------------- Countdown Logic ----------------
if current_time < start:
    remaining = datetime.combine(now.date(), start) - now
    countdown = f"Graph will be available in: {remaining}"
elif current_time > end:
    countdown = "Graph session closed for today."
else:
    countdown = "Graph session is OPEN ✅"

# ---------------- Dashboard HTML ----------------
html_content = f"""
<!DOCTYPE html>
<html>
<head>
<title>Google Play Store Review Analytics Dashboard</title>
<style>
body {{
    font-family: Arial;
    background-color: #000;
    color: white;
    margin: 0;
}}

.header {{
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-color: #111;
}}

.header img {{
    height: 60px;
}}

.header h1 {{
    margin: 0;
    font-size: 28px;
}}

.container {{
    margin: 40px;
    padding: 20px;
    background-color: #111;
    border-radius: 10px;
}}

.time-box {{
    margin-top: 10px;
    font-size: 18px;
    color: #00ff99;
    text-align: center;
}}
</style>
</head>

<body>

<div class="header">
    <img src="https://www.google.com/images/branding/googlelogo/2x/googlelogo_color_272x92dp.png">
    <h1>Google Play Store Review Analytics Dashboard</h1>
</div>

<div class="time-box">
    Current IST Time: {now.strftime("%I:%M:%S %p")}
</div>
<div class="time-box">
    {countdown}
</div>

<div class="container">
    {chart_html}
</div>

</body>
</html>
"""

# ---------------- Save Dashboard ----------------
with open("dashboard.html", "w", encoding="utf-8") as f:
    f.write(html_content)

print("Dashboard created successfully! Open dashboard.html in your browser.")
